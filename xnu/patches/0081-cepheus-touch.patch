+/*
+ * Per-board wiring. The defaults are sweet; the boot-arg sweetcepheus=1
+ * switches to cepheus (Xiaomi Mi 9, SM8150): the touch controller sits on
+ * QupV3 wrapper2 SE0 (0xc80000) instead of wrapper1 SE7, its SDA/SCL are
+ * GPIO 55/56, the interrupt is GPIO 122 and reset GPIO 12.
+ */
+static struct {
+	uint64_t se_pa, tlmm_pa;
+	uint32_t tlmm_size, gcc_rcg;
+	uint32_t branches[5];
+	unsigned sda, scl, irq, rst, pwr;
+	uint32_t fts_addr;
+	unsigned xmax, ymax;
+} hw = {
+	.se_pa = TOUCH_SE_PA,
+	.tlmm_pa = TOUCH_NORTH_PA,
+	.tlmm_size = 0x5b000u,
+	.gcc_rcg = hw.gcc_rcg,
+	.branches = { 0x18004u, 0x18008u, 0x1800cu, 0x18010u, 0x18144u },
+	.sda = 6, .scl = 7, .irq = 9, .rst = 8, .pwr = 90,
+	.fts_addr = 0x38u,
+	.xmax = 1079u, .ymax = 2399u,
+};
+
+static void
+touch_select_board(void)
+{
+	int ceph = 0;
+
+	(void)PE_parse_boot_argn("sweetcepheus", &ceph, sizeof(ceph));
+	if (!ceph) {
+		return;
+	}
+	hw.se_pa = 0x00c80000u;
+	hw.tlmm_pa = 0x03000000u;
+	hw.tlmm_size = 0x00100000u;   /* GPIO 122 lies beyond sweet's 0x5b000 */
+	hw.gcc_rcg = 0x1e148u;        /* gcc_qupv3_wrap2_s0_clk_src */
+	hw.branches[0] = 0x1e004u;
+	hw.branches[1] = 0x1e008u;
+	hw.branches[2] = 0x1e00cu;
+	hw.branches[3] = 0x1e010u;
+	hw.branches[4] = 0x1e144u;
+	hw.sda = 55; hw.scl = 56; hw.irq = 122; hw.rst = 12; hw.pwr = 0;
+	hw.fts_addr = 0x49u;
+	hw.xmax = 1079u; hw.ymax = 2339u;
+	printf("SWEET TOUCH: cepheus profile SE=%#llx RCG=%#x sda=%u scl=%u irq=%u rst=%u\n",
+	    hw.se_pa, hw.gcc_rcg, hw.sda, hw.scl, hw.irq, hw.rst);
+}
